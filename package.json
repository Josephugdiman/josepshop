{
  "name": "sepshop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "cross-env NODE_ENV=development electron .",
    "electron:build": "node scripts/electron-build.cjs",
    "electron:prod": "cross-env NODE_ENV=production electron .",
    "test:display": "node scripts/tests/verifyRegistryDisplay.cjs",
    "test:notifications": "node scripts/tests/notificationsFilter.cjs"
  },
  "build": {
    "appId": "com.marketplace.management",
    "productName": "Marketplace Management System",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "sepshop-release-v13"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "node_modules/**/*",
          ".env"
        ]
      }
    ],
    "asarUnpack": [],
    "win": {
      "target": "nsis",
      "icon": "electron/dist/transparent-image.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Marketplace Management System",
      "installerIcon": "electron/dist/transparent-image.ico",
      "uninstallerIcon": "electron/dist/transparent-image.ico"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "axios": "^1.7.9",
    "chart.js": "^4.4.8",
    "cors": "^2.8.5",
    "es-errors": "^1.3.0",
    "es-toolkit": "^1.44.0",
    "express": "^4.21.2",
    "framer-motion": "^12.4.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.477.0",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.2.0",
    "recharts": "^3.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^22.0.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.10",
    "wait-on": "^9.0.3"
  }
}
